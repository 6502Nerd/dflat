                             ;*  dflat module to enable editing of a dflat pro
                             ;*  dflat bascially starts here - waiting for use
                             ;*  when a line is entered, if it is not preceede
                             ;*  line number it is tokenised and attempted to 
                             ;*  immediatly.  If it is preceeded by a line num
                             ;*  number is used to save the tokenised line in 
                             ;*  position in memory.
                             ;*  So this is just like a good old editing sessi
                             ;*  nearly any common flavour of 80s basic. Howev
                             ;*  tokenises everything except whitespace and st
                             ;*  constants - even when saving.  Unlike my trus
                             ;*  where I could type in any garbage and it woul
                             ;*  saved with the line number, dflat needs to be
                             ;*  tokenise the line.  So it's actually a bit mo
                             ;*  Atari 8 bit BASIC.
                             ;*
                             ;************************************************
                             
dfdc :                       mod_sz_progedit_s
                             
                             ;****************************************
                             ;* df_pg_find_line
                             ;* Find a line number in X(L), A(H)
                             ;* Return X(L), A(H) of line, Y = Length
                             ;* C=1 Exact match not found, C=0 Exact Found
                             ;* If not exact match then next highest line addr
                             ;* Will be in X and A
                             ;****************************************
dfdc :                       df_pg_find_line
dfdc : 863d             [ 3] 	stx num_a
dfde : 853e             [ 3] 	sta num_a+1
dfe0 : a566             [ 3] 	lda df_prgstrt
dfe2 : 8549             [ 3] 	sta num_tmp
dfe4 : a567             [ 3] 	lda df_prgstrt+1
dfe6 : 854a             [ 3] 	sta num_tmp+1
dfe8 :                       df_pg_check_next_line
dfe8 : a549             [ 3] 	lda num_tmp
dfea : c568             [ 3] 	cmp df_prgend
dfec : d011             [ 3] 	bne df_pg_check_line
dfee : a54a             [ 3] 	lda num_tmp+1
dff0 : c569             [ 3] 	cmp df_prgend+1
dff2 : d00b             [ 3] 	bne df_pg_check_line
dff4 :                       df_pr_line_gt_target	
                             	; End of program or line > target
                             	; X,A = address of finish
                             	; Load Y with the length
dff4 : a200             [ 2] 	ldx #0
dff6 : a149             [ 6] 	lda (num_tmp,x)
dff8 : a8               [ 2] 	tay
dff9 : a649             [ 3] 	ldx num_tmp
dffb : a54a             [ 3] 	lda num_tmp+1
dffd : 38               [ 2] 	sec
dffe : 60               [ 6] 	rts
dfff :                       df_pg_check_line
dfff : 38               [ 2] 	sec					; Do a trial subtract of
e000 : a001             [ 2] 	ldy #DFTK_LINNUM	; target - line
e002 : a53d             [ 3] 	lda num_a
e004 : f149             [ 5] 	sbc (num_tmp),y
e006 : 854b             [ 3] 	sta num_tmp+2		; Partial result of sbc
e008 : c8               [ 2] 	iny
e009 : a53e             [ 3] 	lda num_a+1
e00b : f149             [ 5] 	sbc (num_tmp),y
AS65 Assembler for R6502 [1.42].                                     Page  187
---------------------------------- bank0.s -----------------------------------

e00d : 054b             [ 3] 	ora num_tmp+2		; or with partial result for z ch
                             	; If C=0 then line > target (done)
e00f : 90e3             [ 4] 	bcc df_pr_line_gt_target
                             	; If partial result Z=0 then got an exact match
e011 : f00f             [ 3] 	beq df_pr_line_match
                             	; Else we go to next line
e013 : a200             [ 2] 	ldx #0
e015 : 18               [ 2] 	clc
e016 : a549             [ 3] 	lda num_tmp
e018 : 6149             [ 6] 	adc (num_tmp,x)
e01a : 8549             [ 3] 	sta num_tmp
e01c : 90ca             [ 4] 	bcc df_pg_check_next_line
e01e : e64a             [ 5] 	inc num_tmp+1
e020 : d0c6             [ 4] 	bne df_pg_check_next_line	; Always
e022 :                       df_pr_line_match
e022 : a200             [ 2] 	ldx #0
e024 : a149             [ 6] 	lda (num_tmp,x)
e026 : a8               [ 2] 	tay
e027 : a649             [ 3] 	ldx num_tmp
e029 : a54a             [ 3] 	lda num_tmp+1
e02b : 18               [ 2] 	clc
e02c : 60               [ 6] 	rts
                             	
                             ;****************************************
                             ;* df_pg_insert_block
                             ;* Insert a block at adr (X, A) of size Y
                             ;* df_prgend updated
                             ;* C=1 Error, C=0 Ok
                             ;****************************************
e02d :                       df_pg_insert_block
                             	; Inserting requires a block copy from
                             	; end of program space to the insert address
                             	
                             	; Save address as this is the lowest address
e02d : 863d             [ 3] 	stx num_a
e02f : 853e             [ 3] 	sta num_a+1
                             	; End of program space is the first byte to move
e031 : a568             [ 3] 	lda df_prgend
e033 : 8545             [ 3] 	sta num_x
e035 : a569             [ 3] 	lda df_prgend+1
e037 : 8546             [ 3] 	sta num_x+1	
e039 :                       df_pg_insert_byte
                             	; Move a byte from the current top
e039 : a200             [ 2] 	ldx #0
e03b : a145             [ 6] 	lda (num_x,x)
                             	; To the new top (+Y)
e03d : 9145             [ 5] 	sta (num_x),y
                             	; Compare current address with lowest
e03f : a545             [ 3] 	lda num_x
e041 : c53d             [ 3] 	cmp num_a
e043 : d012             [ 3] 	bne df_pg_insert_next_byte
e045 : a546             [ 3] 	lda num_x+1
e047 : c53e             [ 3] 	cmp num_a+1
e049 : d00c             [ 3] 	bne df_pg_insert_next_byte
                             	; Finished, update program end pointer
e04b : 18               [ 2] 	clc
e04c : 98               [ 2] 	tya
