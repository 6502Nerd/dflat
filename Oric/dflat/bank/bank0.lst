c1ad : b01c             [ 3] 	bcs	str_x_to_a_err	; Error if not
                             
c1af : 0a               [ 2] 	asl a				; This is the high nibble
c1b0 : 0a               [ 2] 	asl a
c1b1 : 0a               [ 2] 	asl a
