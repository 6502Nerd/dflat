                             ;*
                             ;*  KEYBOARD.S
                             ;*	Keyboard driver code. It is very slow to scan 
                             ;*	routines here do a basic scan for any key befo
                             ;*	the specific key. Still, it has a noticeable i
                             ;*	CPU especially in dflat which checks the key a
                             ;*	keyword is executed.
                             ;*	Rather than working off interrupts these routi
                             ;*	need to be called as needed. The T1 interrupt 
                             ;*	track of keyboard timers for repeat delay and 
                             ;*
                             ;************************************************
                             
                             	; ROM code
                             	code
                             
                             ;****************************************
                             ;* init_keyboard
                             ;* Initialise the keyboard settings
                             ;****************************************
c83d :                       init_keyboard
c83d : a914             [ 2] 	lda #KB_REP_DEL
c83f : 8531             [ 3] 	sta kb_rdel_tim
c841 : a903             [ 2] 	lda #KB_REP_TIM
c843 : 8530             [ 3] 	sta kb_rep_tim
c845 : a901             [ 2] 	lda #KB_DEBOUNCE
c847 : 852e             [ 3] 	sta kb_deb_tim
                             
                             	; ** check if IJK stick connected **
AS65 Assembler for R6502 [1.42].                                     Page   90
---------------------------------- bank0.s -----------------------------------

c849 : 08               [ 3] 	php
c84a : 78               [ 2] 	sei
                             	; Save port A
c84b : ad0303           [ 4] 	lda IO_0+DDRA
c84e : 48               [ 3] 	pha
c84f : ad0103           [ 4] 	lda IO_0+PRA
c852 : 48               [ 3] 	pha
                             
                             	; Check IJK present
                             	; set top two bits of porta to output and rest a
c853 : a9c0             [ 2] 	lda   #0b11000000
c855 : 20c7c4           [ 6] 	jsr via_strobe_init
                             	; Select left+right stick
c858 : a9c0             [ 2] 	lda #0b11000000
c85a : 8d0f03           [ 4] 	sta IO_0+PRAH
                             	; read stick sense line
c85d : ad0f03           [ 4] 	lda IO_0+PRAH
c860 : 2920             [ 2] 	and #KB_IJK
c862 : 4920             [ 2] 	eor #KB_IJK
c864 : 852c             [ 3] 	sta kb_stat
c866 : 20d3c4           [ 6] 	jsr via_strobe_off
                             
                             	; Restore port A
c869 : 68               [ 4] 	pla
c86a : 8d0103           [ 4] 	sta IO_0+PRA
c86d : 68               [ 4] 	pla
c86e : 8d0303           [ 4] 	sta IO_0+DDRA
                             
c871 : 28               [ 4] 	plp
c872 : 60               [ 6] 	rts
                             
                             
                             ;****************************************
                             ;* kb_stick
                             ;* Check for fire | down | up | right | left
                             ;*        bit  4     3      2     1       0
                             ;* A = Returns bit mask of keys pressed
                             ;* Y corrupted
                             ;****************************************
c873 :                       kb_stick
c873 : 08               [ 3] 	php
c874 : 78               [ 2] 	sei
