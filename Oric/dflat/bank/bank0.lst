d5fe : 03                    	db 0x03				; R12 = Envelope Period High
d5ff : 00                    	db 0b00000000		; R13 = Envelope Shape : 0000
d600 : ff                    	db 0xff				; R14 = IO Port A - KB lines disabled
d601 : 00                    	db 0x00				; R15 = IO Port B ; Initialise to 0 (
                             
