                             ;****************************************
                             ;* vdp_init_font
                             ;* Initialise fonts from ROM
                             ;* Input : None
                             ;* Output : None
                             ;* Regs affected : All
                             ;****************************************
ce19 :                       gr_init_font
                             	; Get char base from vdp structure
ce19 : a614             [ 3] 	ldx gr_scrngeom+gr_char
ce1b : 8634             [ 3] 	stx tmp_blo
ce1d : a615             [ 3] 	ldx gr_scrngeom+gr_char+1
ce1f : e8               [ 2] 	inx						; ASCII patterns start 1 page later
ce20 : 8635             [ 3] 	stx tmp_bhi
                             
ce22 : a919             [ 2] 	lda #lo(vdp_font)		; Low byte of fonts source
ce24 : 8536             [ 3] 	sta tmp_clo
ce26 : a9cb             [ 2] 	lda #hi(vdp_font)		; High byte of fonts source
ce28 : 8537             [ 3] 	sta tmp_chi
ce2a : a203             [ 2] 	ldx #3					; Copy 3 pages
ce2c : 4c2fce           [ 3] 	jmp gr_copy_mem
                             
                             
                             ;****************************************
                             ;* vdp_copy_mem
                             ;* Copy memory pages at a time
                             ;* Input :	clo/hi	=	source
                             ;*			blo/hi	=	dest
                             ;*			X		=	pages to copy
                             ;* Output : None
                             ;* Regs affected : All
                             ;****************************************
ce2f :                       gr_copy_mem
ce2f : a000             [ 2] 	ldy #0					; byte within page
ce31 : a536             [ 3] 	lda tmp_clo				; Low byte of source
ce33 : 8532             [ 3] 	sta tmp_alo
ce35 : a537             [ 3] 	lda tmp_chi				; High byte of source
ce37 : 8533             [ 3] 	sta tmp_ahi
ce39 :                       gr_copy_byte
ce39 : 98               [ 2] 	tya
ce3a : b132             [ 5] 	lda (tmp_alo),y			; Get byte from font table
ce3c : 9134             [ 5] 	sta (tmp_blo),y			; Put it to the memory
ce3e : c8               [ 2] 	iny
ce3f : d0f8             [ 3] 	bne gr_copy_byte		; keep going for 1 page
ce41 : e633             [ 5] 	inc tmp_ahi				; only need to increment high byt
ce43 : e635             [ 5] 	inc tmp_bhi				; source and destination ptr
ce45 : ca               [ 2] 	dex						; page counter
ce46 : d0f1             [ 3] 	bne gr_copy_byte		; keep going for X pages
ce48 : 60               [ 6] 	rts
                             
                             
