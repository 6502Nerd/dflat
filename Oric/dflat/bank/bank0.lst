                             	sta MIA_STEP0
                             	lda MIA_RW0					; Step back xmem ptr too
                             lc_dir_path_push_ch
                             	lda MIA_RW0
                             	sta MIA_XSTACK
                             	dey
                             	bne lc_dir_path_push_ch
                             lc_dir_path_done
