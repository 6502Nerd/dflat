cdd1 : 9134             [ 5] 	sta (tmp_blo),y			; Put it to the memory
cdd3 : c8               [ 2] 	iny
cdd4 : d0f8             [ 3] 	bne gr_copy_byte		; keep going for 1 page
cdd6 : e633             [ 5] 	inc tmp_ahi				; only need to increment high byt
cdd8 : e635             [ 5] 	inc tmp_bhi				; source and destination ptr
cdda : ca               [ 2] 	dex						; page counter
cddb : d0f1             [ 3] 	bne gr_copy_byte		; keep going for X pages
cddd : 60               [ 6] 	rts
                             
                             
