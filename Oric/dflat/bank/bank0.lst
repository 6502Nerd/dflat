c18c : 9002             [ 3] 	bcc skip_a_f_1		; skip a-f adjustment
c18e : 6926             [ 2] 	adc #0x26			; Add 27 (6+C) to get in to A-F rang
c190 :                       skip_a_f_1
c190 : aa               [ 2] 	tax					; Low char is in X
c191 : 68               [ 4] 	pla					; Get byte back
c192 : 4a               [ 2] 	lsr a				; Make high nibble low
c193 : 4a               [ 2] 	lsr a
c194 : 4a               [ 2] 	lsr a
c195 : 4a               [ 2] 	lsr a
