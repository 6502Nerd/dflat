cdc1 : 4cc4cd           [ 3] 	jmp gr_copy_mem
                             
                             
                             ;****************************************
                             ;* vdp_copy_mem
                             ;* Copy memory pages at a time
                             ;* Input :	clo/hi	=	source
                             ;*			blo/hi	=	dest
                             ;*			X		=	pages to copy
                             ;* Output : None
                             ;* Regs affected : All
                             ;****************************************
cdc4 :                       gr_copy_mem
cdc4 : a000             [ 2] 	ldy #0					; byte within page
cdc6 : a536             [ 3] 	lda tmp_clo				; Low byte of source
cdc8 : 8532             [ 3] 	sta tmp_alo
cdca : a537             [ 3] 	lda tmp_chi				; High byte of source
cdcc : 8533             [ 3] 	sta tmp_ahi
