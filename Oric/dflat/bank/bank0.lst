                             	sty tp_flag					; Y already zero from xmem init
                             	lda df_linbuff				; if the dir '/' ?
                             	cmp #'/'
                             	bne lc_init_dir_end
                             	jmp lc_init_path			; Then back to dflat root
                             lc_init_dir_end
                             	iny
                             	lda MIA_RW0
                             	bne lc_init_dir_end
                             	ldx #0
                             	dey							; Overwrite the zero in xmem0
