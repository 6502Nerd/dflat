c78a : 2092c7           [ 6] 	jsr tp_read_bit
c78d : 6a               [ 2] 	ror a
c78e : 88               [ 2] 	dey
c78f : d0f9             [ 3] 	bne tp_read_byte_bits
                             	; Byte is in A, stop bit is not waited for..
c791 :                       tt_readbyte_end_pc			; ** FOR ORICUTRON EMULATOR 
c791 : 60               [ 6] 	rts
                             
