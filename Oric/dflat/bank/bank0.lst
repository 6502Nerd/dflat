c875 : a52c             [ 3] 	lda kb_stat
c877 : 2920             [ 2] 	and #KB_IJK
c879 : d029             [ 3] 	bne kb_stick_ijk
                             
                             	; Select Row 4 only, all keys on this row
c87b : a9b4             [ 2] 	lda #4+KB_PRB			; Maintain upper nibble of PRB
c87d : 8d0003           [ 4] 	sta IO_0+PRB
c880 : a90e             [ 2] 	lda #SND_REG_IOA		; Select AY Port A for columns
c882 : 204ec0           [ 6] 	jsr snd_sel_reg
c885 : a900             [ 2] 	lda #0					; Result will be in A
c887 : 48               [ 3] 	pha
c888 : a004             [ 2] 	ldy #4					; Go through the 5 cols on row 4
c88a :                       kb_stick_pos
c88a : b989ca           [ 4] 	lda kb_stick_mask,y		; Get the column mask
c88d : 205ec0           [ 6] 	jsr snd_set_reg			; Activate column
c890 : ea               [ 2] 	nop
c891 : ea               [ 2] 	nop
c892 : ea               [ 2] 	nop
c893 : ea               [ 2] 	nop
