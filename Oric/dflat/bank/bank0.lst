d597 : f011             [ 3] 	beq cmd_parse_byte_err	; If no char then error w
d599 : 48               [ 3] 	pha						; Save on stack
d59a : c8               [ 2] 	iny
d59b : b139             [ 5] 	lda (buf_lo),y			; Get lo nibble of high byte
d59d : f00a             [ 3] 	beq cmd_parse_byte_errp	; If no char then error 
d59f : aa               [ 2] 	tax						; Lo nibble goes to X
d5a0 : 68               [ 4] 	pla						; Restore hi nibble
d5a1 : 20a0c1           [ 6] 	jsr str_x_to_a			; Convert from hex to A
d5a4 : b004             [ 3] 	bcs cmd_parse_byte_err	; If error then stop
d5a6 : c8               [ 2] 	iny						; Point to next char
d5a7 : 18               [ 2] 	clc
d5a8 : 60               [ 6] 	rts						; A contains the byte
