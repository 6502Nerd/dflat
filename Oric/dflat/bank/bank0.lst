d5cf : 98               [ 2] 	tya
d5d0 : 0a               [ 2] 	asl a
d5d1 : a8               [ 2] 	tay
                             	; Get note for octave 1
d5d2 : b902d6           [ 4] 	lda snd_music_tab,y
d5d5 : 8532             [ 3] 	sta tmp_alo
d5d7 : b903d6           [ 4] 	lda snd_music_tab+1,y
                             	
d5da :                       snd_get_note_oct
d5da : ca               [ 2] 	dex
d5db : f006             [ 3] 	beq snd_note_done
                             	; Divide freq by 2 each octave
d5dd : 4a               [ 2] 	lsr a
d5de : 6632             [ 5] 	ror tmp_alo
d5e0 : 4cdad5           [ 3] 	jmp snd_get_note_oct
d5e3 :                       snd_note_done
d5e3 : a632             [ 3] 	ldx tmp_alo
d5e5 : 60               [ 6] 	rts
