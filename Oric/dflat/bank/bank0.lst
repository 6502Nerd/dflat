e094 : a54a             [ 3] 	lda num_tmp+1
e096 : 18               [ 2] 	clc
e097 : 60               [ 6] 	rts
                             	
                             ;****************************************
                             ;* df_pg_insert_block
                             ;* Insert a block at adr (X, A) of size Y
                             ;* df_prgend updated
                             ;* C=1 Error, C=0 Ok
                             ;****************************************
e098 :                       df_pg_insert_block
                             	; Inserting requires a block copy from
                             	; end of program space to the insert address
                             	
                             	; Save address as this is the lowest address
e098 : 863d             [ 3] 	stx num_a
e09a : 853e             [ 3] 	sta num_a+1
                             	; End of program space is the first byte to move
e09c : a568             [ 3] 	lda df_prgend
e09e : 8545             [ 3] 	sta num_x
e0a0 : a569             [ 3] 	lda df_prgend+1
e0a2 : 8546             [ 3] 	sta num_x+1	
e0a4 :                       df_pg_insert_byte
                             	; Move a byte from the current top
e0a4 : a200             [ 2] 	ldx #0
e0a6 : a145             [ 6] 	lda (num_x,x)
                             	; To the new top (+Y)
e0a8 : 9145             [ 5] 	sta (num_x),y
                             	; Compare current address with lowest
e0aa : a545             [ 3] 	lda num_x
e0ac : c53d             [ 3] 	cmp num_a
e0ae : d012             [ 3] 	bne df_pg_insert_next_byte
e0b0 : a546             [ 3] 	lda num_x+1
e0b2 : c53e             [ 3] 	cmp num_a+1
e0b4 : d00c             [ 3] 	bne df_pg_insert_next_byte
                             	; Finished, update program end pointer
