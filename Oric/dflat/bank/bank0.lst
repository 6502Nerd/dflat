                             ;* tp_write_bit
                             ;* Write a bit in C to tape which looks like this
                             ;* Half cycle of 4800Hz, then
                             ;*		half cycle of 4800Hz for a 1
                             ;*		half cycle of 2400Hz for a 0
c6de :                       tp_write_bit
c6de : 48               [ 3] 	pha
c6df : 8a               [ 2] 	txa
c6e0 : 48               [ 3] 	pha
c6e1 : 08               [ 3] 	php						; Save the bit to be stored
                             
c6e2 : a9d0             [ 2] 	lda #TAPE_RATE			; Half cycle first of 4800Hz
c6e4 : a200             [ 2] 	ldx #0
c6e6 : 8d0603           [ 4] 	sta IO_0+T1LL
c6e9 : 8e0703           [ 4] 	stx IO_0+T1LH			; This starts the timer
c6ec : ad0403           [ 4] 	lda IO_0+T1CL			; Clear any interrupt flag
c6ef :                       tp_write_bit_chk1
c6ef : 2c0d03           [ 4] 	bit IO_0+IFR			; Check IRF for bit 6
c6f2 : 50fb             [ 3] 	bvc tp_write_bit_chk1	; V=0? Keep checking
c6f4 : ad0403           [ 4] 	lda IO_0+T1CL			; Clear interrupt flag
                             	
c6f7 : 28               [ 4] 	plp						; Get the bit to be stored
c6f8 : a9d0             [ 2] 	lda #TAPE_RATE			; Assume putting out a 1 in 2nd
c6fa : b002             [ 3] 	bcs tp_write_bit_t1		; A zero is half the rate (
c6fc : 0a               [ 2] 	asl	a					; TAPE_RATE * 2 need to inc X
c6fd : e8               [ 2] 	inx
c6fe :                       tp_write_bit_t1
c6fe : 8d0603           [ 4] 	sta IO_0+T1LL
c701 : 8e0703           [ 4] 	stx IO_0+T1LH			; This starts the timer
c704 : ad0403           [ 4] 	lda IO_0+T1CL			; Clear any interrupt flag
c707 :                       tp_write_bit_chk2
c707 : 2c0d03           [ 4] 	bit IO_0+IFR			; Check IRF for bit 6
c70a : 50fb             [ 3] 	bvc tp_write_bit_chk2	; V=0? Keep checking
c70c : ad0403           [ 4] 	lda IO_0+T1CL			; Clear interrupt flag
c70f : 68               [ 4] 	pla
c710 : aa               [ 2] 	tax
c711 : 68               [ 4] 	pla
c712 : 60               [ 6] 	rts
                             
                             
                             
