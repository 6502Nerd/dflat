cdb7 : a9ae             [ 2] 	lda #lo(vdp_font)		; Low byte of fonts source
cdb9 : 8536             [ 3] 	sta tmp_clo
cdbb : a9ca             [ 2] 	lda #hi(vdp_font)		; High byte of fonts source
cdbd : 8537             [ 3] 	sta tmp_chi
